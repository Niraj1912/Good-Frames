<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash screen in dark mode. Needed as well as values-v31:
     Android prefers a night-mode match over a version match, so without it
     dark mode would fall back to values-night and lose the splash colour. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
    </style>
</resources>
