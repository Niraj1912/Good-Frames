<?xml version="1.0" encoding="utf-8"?>
<!-- The icon in one colour, for Android 13+ "themed icons": the system tints
     it to match the wallpaper, so only shape and transparency count. The same
     three cards as the logo: the photo in front, the delete card behind it
     on the left and the keep card on the right, with the photo's picture cut
     out of the card. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left card, tilted. -->
    <group
        android:pivotX="38"
        android:pivotY="54"
        android:rotation="-10">
        <path
            android:fillAlpha="0.45"
            android:fillColor="#FFFFFF"
            android:pathData="M31,42 H46 A3,3 0 0 1 49,45 V62 A3,3 0 0 1 46,65 H31 A3,3 0 0 1 28,62 V45 A3,3 0 0 1 31,42 Z" />
    </group>

    <!-- Right card, tilted the other way. -->
    <group
        android:pivotX="70"
        android:pivotY="54"
        android:rotation="10">
        <path
            android:fillAlpha="0.45"
            android:fillColor="#FFFFFF"
            android:pathData="M62,42 H77 A3,3 0 0 1 80,45 V62 A3,3 0 0 1 77,65 H62 A3,3 0 0 1 59,62 V45 A3,3 0 0 1 62,42 Z" />
    </group>

    <!-- The photo in front: a card with the sun and the mountains cut out. -->
    <group
        android:pivotX="54"
        android:pivotY="50"
        android:rotation="3">
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M44,34 H64 A4,4 0 0 1 68,38 V62 A4,4 0 0 1 64,66 H44 A4,4 0 0 1 40,62 V38 A4,4 0 0 1 44,34 Z M43,62 L52,49 L57,55 L61,51 L65,62 Z M58,42 A3,3 0 1 0 64,42 A3,3 0 1 0 58,42 Z" />
    </group>
</vector>
