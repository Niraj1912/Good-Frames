<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon, as an adaptive icon: a background and a foreground layer
     that each launcher crops to its own shape (circle, squircle...) and can
     animate. The foreground is a PNG made by tool/make_icon.dart from the
     Good Frames logo (the cards and pills, without the tile's rim); the
     app needs Android 11+, so no per-density PNGs for older phones are needed. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
