# tool\make_release_key.ps1 makes the key and key.properties for you. To do
# it by hand, make a key with keytool, then copy this file to key.properties
# (same folder) and fill in your values.
# key.properties holds passwords, so git ignores it: never commit it, and
# keep the .jks file outside the project folder.
#
# Use forward slashes in the path, even on Windows: in this file format a
# backslash starts an escape code.
storeFile=C:/Users/YOU/keys/swipesort-release.jks
storePassword=
keyAlias=swipesort
# Same as storePassword: keytool's default PKCS12 keystores use one password.
keyPassword=
